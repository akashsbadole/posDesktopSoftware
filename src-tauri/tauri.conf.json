{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../out"
  },
  "package": {
    "productName": "POS Billing",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "dialog": { "all": true },
      "fs": {
        "all": true,
        "scope": ["$APPDATA/*", "$DOCUMENT/*", "$DOWNLOAD/*"]
      },
      "path": { "all": true },
      "window": { "all": true },
      "http": {
        "all": true,
        "scope": ["https://*.neon.tech/*", "https://*.neon.tech"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.posbilling.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "Business",
      "shortDescription": "Restaurant POS Billing System",
      "windows": {
        "wix": {
          "language": "en-US"
        }
      }
    },
    "security": { "csp": null },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "POS Billing",
        "width": 1280,
        "height": 780,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": true,
        "center": true
      }
    ]
  }
}
