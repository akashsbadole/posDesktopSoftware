# ==============================================
# POS Tauri Application Environment Variables
# ==============================================

# Copy this file to .env and fill in your actual values

# Node Environment
# Valid values: development | production | test
NODE_ENV=development

# CI Environment Flag
# Uncomment this when running in CI/CD pipelines
# CI=true

# ==============================================
# POS Configuration
# ==============================================
NEXT_PUBLIC_DEFAULT_STORE_NAME=My POS Store
NEXT_PUBLIC_DEFAULT_STORE_ID=default

# Default business industry:
# Available options: food, retail, salon, gym, general
NEXT_PUBLIC_DEFAULT_INDUSTRY=food

# ==============================================
# Database Configuration
# ==============================================
# Neon PostgreSQL Database URL
# Get this from your Neon dashboard: Project → Connection Details → Connection String
# Format: postgres://user:password@host/database
# Note: This URL is stored encrypted and used for cloud synchronization.
NEXT_PUBLIC_NEON_URL=

# ==============================================
# External Integrations
# ==============================================
# WhatsApp Business API Endpoint
NEXT_PUBLIC_WHATSAPP_API=

# ==============================================
# Feature Flags
# ==============================================
# Enable premium features (true/false)
NEXT_PUBLIC_ENABLE_PREMIUM=false

# ==============================================
# Tauri Security Configuration
# ==============================================
# Tauri encryption key for sensitive data encryption (Rust backend)
# Generate a secure 32-byte (256-bit) key for AES-256-GCM
# You can generate one using: openssl rand -hex 32
TAURI_ENCRYPTION_KEY=your-secure-32-byte-encryption-key-here

# Frontend encryption key for localStorage data
# Should be a strong passphrase (min 16 characters)
NEXT_PUBLIC_ENCRYPTION_KEY=

# ==============================================
# SSL Certificates
# ==============================================
# Optional custom CA certificates file path
# NODE_EXTRA_CA_CERTS=